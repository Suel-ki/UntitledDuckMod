{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "Suel_ki",
    "Okabintaro",
    "ArtistMonster24"
  ],
  "contributors": [
    "Frank <github.com/quiqueck>",
    "Kevin Köllmann <github.com/koelle25>",
    "Chubz <github.com/Chubzik1>",
    "Utsuda Shinou <github.com/utsudashinou>"
  ],
  "contact": {
    "homepage": "https://github.com/UntitledDuckDevs/UntitledDuckMod",
    "sources":  "https://github.com/UntitledDuckDevs/UntitledDuckMod",
    "issues":  "https://github.com/UntitledDuckDevs/UntitledDuckMod/issues"
  },
  "license": "${license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.untitledduckmod.fabric.DuckModFabric"
    ],
    "client": [
      "net.untitledduckmod.client.fabric.DuckModFabricClientSetup"
    ],
    "modmenu": [
      "net.untitledduckmod.common.config.fabric.DuckModMenu"
    ],
    "jade": [
      "net.untitledduckmod.compat.jade.JadePlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "geckolib": "*"
  },
  "mixins": [
    "untitledduckmod.mixins.json",
    "untitledduckmod_fabric.mixins.json"
  ]
}